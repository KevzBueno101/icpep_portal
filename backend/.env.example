# ICPEP Portal - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# Django
SECRET_KEY=your-django-secret-key-here
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database (Neon PostgreSQL)
DB_NAME=icpep_db
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_HOST=your-db-host.neon.tech
DB_PORT=5432
DB_SSLMODE=require

# Groq API (for chatbot) - create a free key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here
# GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Cloudinary (Media Storage)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Email (Resend/SendGrid/Gmail)
SENDGRID_API_KEY=your-sendgrid-key
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=ICPEP Portal <noreply@icpep.com>
BUG_REPORT_EMAIL=icpep.se.catsuchapter@gmail.com

# Frontend URL (for CORS, password reset links, etc.)
FRONTEND_URL=http://localhost:5173

# CORS (comma-separated, optional - regexes used if not set)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-vercel-app.vercel.app

# Web Push (VAPID) - generate with: python -c "from pywebpush import generate_vapid_keys; print(generate_vapid_keys())"
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_CLAIMS_EMAIL=icpep.se.catsuchapter@gmail.com